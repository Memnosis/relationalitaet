  "order_transformations": [
    {
      "id": "OW-01",
      "op": "axis_permutation",
      "rule": "(i,j,k) → (j,k,i)",
      "inverse": "(i,j,k) → (k,i,j)",
      "geometric": "Schicht-/Achsenwechsel",
      "semantic": "nur mitgeführt als typisierte Achsen- und Rollenbeschriftungen",
      "proof": "permutation and inverse exact",
      "category": "representation"
    },
    {
      "id": "OW-02",
      "op": "coordinate_embedding",
      "rule": "(i,j,k) → geometrischer Punkt (i,j,k)",
      "inverse": "Koordinaten lesen, sofern Raster und Label erhalten",
      "geometric": "3D-Punktmodell",
      "semantic": "Metadaten bleiben eigene Träger; Koordinaten allein nicht bedeutungstreu",
      "proof": "27 distinct points",
      "category": "representation"
    },
    {
      "id": "OW-03",
      "op": "projection",
      "rule": "(i,j,k) → (i,j)",
      "inverse": "nicht eindeutig",
      "geometric": "3D→2D",
      "semantic": "3. Achse verliert sich; drei Rollenlagen fallen zusammen",
      "proof": "27 to 9 coordinates",
      "category": "lossy"
    },
    {
      "id": "OW-04",
      "op": "cycle_shift",
      "rule": "(i,j,k) → (i+1,j+1,k+1) mod 3",
      "inverse": "zweimal weitere Verschiebung",
      "geometric": "neun Dreierbahnen",
      "semantic": "nur ein Zyklus der Adressen; für Fachrollen nur bei freigegebener Rollenabbildung",
      "proof": "F³=id",
      "category": "index_only"
    },
    {
      "id": "OW-05",
      "op": "crossworld_role_binding",
      "rule": "W1(a,b,c) ↦ W2(u(a),v(b),w(c))",
      "inverse": "nur falls Achsenübersetzungen bijektiv und bedeutungserhaltend",
      "geometric": "Umbenannte oder gekoppelten Ganzheiten",
      "semantic": "keine automatischen LU↔DONOR-Identitäten",
      "proof": "requires source-defined maps",
      "category": "hypothesis"
    },
    {
      "id": "OW-06",
      "op": "graph_reconstruction",
      "rule": "getypte Kanten + gemeinsame Dreier-Relation → visualisierter Hypergraph",
      "inverse": "nur wenn Hyperkantenkennungen und Rollen mitgespeichert",
      "geometric": "Hypergraph / Bewegungspfad",
      "semantic": "Wegfall einer Rollen-ID ist Verletzung",
      "proof": "requires encoded hyperedges",
      "category": "hypothesis"
    }
  ],
