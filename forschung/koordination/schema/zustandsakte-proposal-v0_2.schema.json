{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemeinsame Zustandsakte - Vorschlagsformat eines kanonischen Snapshots",
  "description": "PROPOSAL v0.2 with Claude's P1/P2/P5/P6/P7 schema gates; P3/P4 and real provenance/author-verification require reducer. SHA must be real digest validated beyond the pattern; generated_at excluded from canonical JCS snapshot hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "source_commit",
    "input_manifest_sha256",
    "visibility",
    "entities",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "zustandsakte/0.2-proposal"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "visibility": {
      "enum": [
        "private",
        "public_projection"
      ]
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "owner",
          "work",
          "validation",
          "science",
          "exchange",
          "release",
          "cycle",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "type": {
            "enum": [
              "task",
              "claim",
              "source",
              "test",
              "prompt",
              "skill",
              "relation",
              "trinity",
              "tensor",
              "field",
              "review",
              "decision",
              "cycle",
              "publication"
            ]
          },
          "owner": {
            "enum": [
              "gpt",
              "claude",
              "joint",
              "nils",
              "external"
            ]
          },
          "work": {
            "enum": [
              "queued",
              "working",
              "delivered",
              "blocked",
              "canceled",
              "not_applicable"
            ]
          },
          "validation": {
            "enum": [
              "untested",
              "skipped",
              "owner_tested",
              "peer_tested",
              "reproduced",
              "replicated",
              "failed",
              "inconclusive",
              "not_applicable"
            ]
          },
          "science": {
            "enum": [
              "unassessed",
              "supported_with_scope",
              "contradicted",
              "unresolved",
              "not_applicable"
            ]
          },
          "exchange": {
            "enum": [
              "awaiting_response",
              "responded",
              "acknowledged",
              "disputed",
              "closed",
              "not_applicable"
            ]
          },
          "release": {
            "enum": [
              "private",
              "candidate",
              "author_approved",
              "published",
              "withheld",
              "revoked"
            ]
          },
          "cycle": {
            "enum": [
              "open",
              "blocked",
              "eligible_for_closure",
              "closed",
              "not_applicable"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_scope": {
            "type": "string"
          },
          "public_summary": {
            "type": "string",
            "maxLength": 240
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "confidentiality": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "decision_ref": {
            "type": "string",
            "pattern": "^DEC-"
          },
          "reply_by": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_grade": {
            "enum": [
              "D",
              "F",
              "O",
              "K",
              "B",
              "offen",
              "not_applicable"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "validation": {
                  "enum": [
                    "peer_tested",
                    "reproduced",
                    "replicated"
                  ]
                }
              },
              "required": [
                "validation"
              ]
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "release": {
                  "enum": [
                    "author_approved",
                    "published"
                  ]
                }
              },
              "required": [
                "release"
              ]
            },
            "then": {
              "required": [
                "decision_ref"
              ]
            }
          }
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "entity_id",
          "kind",
          "actor",
          "source_commit",
          "evidence_refs"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 3
          },
          "entity_id": {
            "type": "string",
            "minLength": 3
          },
          "kind": {
            "enum": [
              "created",
              "submitted",
              "delivered",
              "test_run",
              "peer_review",
              "acknowledged",
              "disputed",
              "decision",
              "release_granted",
              "release_revoked",
              "superseded",
              "blocked"
            ]
          },
          "actor": {
            "enum": [
              "gpt",
              "claude",
              "nils",
              "validator",
              "external"
            ]
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "supersedes": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "script_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "inconclusive"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "test_run"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "exit_code",
                "input_sha256",
                "script_sha256",
                "outcome"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "public_projection"
          }
        },
        "required": [
          "visibility"
        ]
      },
      "then": {
        "properties": {
          "entities": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "confidentiality": {
                      "const": "public"
                    },
                    "release": {
                      "const": "published"
                    }
                  },
                  "required": [
                    "confidentiality"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
