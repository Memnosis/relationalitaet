      "deliverables": [
        "functional_catalog_of_15_possible_capabilities",
        "eight_handoff_cards",
        "separate_public_and_nonpublic_feedback",
        "identified_work_sites_with_review_gates"
      ],
      "exit": "all capabilities labeled by actual maturity and all input channels labeled by visibility and purpose"
    },
    {
      "id": "SW-PH-1",
      "title": "Explain language hinges and translation losses",
      "deliverables": [
        "bidirectional_translation_cases",
        "practical_legal_and_health_distinctions",
        "feedback_help_kernel",
        "counterexamples"
      ],
      "exit": "each P0 pivot explained with status and source gap"
    },
    {
      "id": "SW-PH-2",
      "title": "Curate knowledge rooms and credible 2–3 links",
      "deliverables": [
        "definition_world",
        "path_world",
        "source_world",
        "perspective_world",
        "meta_world",
        "research_world",
        "method_world"
      ],
      "exit": "expanded modules substantial; links have relevance notes"
    },
    {
      "id": "SW-PH-3",
      "title": "Publish reviewed topic pages and optional concise components",
      "deliverables": [
        "therapy_topic",
        "social_payment_topic",
        "help_and_ngo_links",
        "coffee_methods_as_ideas"
      ],
      "exit": "source/translation/browser tests passed"
    },
    {
      "id": "SW-PH-4",
      "title": "Extend across education housing digital and public projects",
      "deliverables": [
        "new_vertical_pilots",
        "local_network_project_links",
        "public_feedback_protocol"
      ],
      "exit": "new topic has full evidence, risk and no-loss crosswalk"
    },
    {
      "id": "SW-PH-5",
      "title": "Specialist research, tensor comparisons and potential emergent hybrid barcamp",
      "deliverables": [
        "research_papers",
        "optional_network_visualization",
        "barcamp_as_conditional_idea_not_event"
      ],
      "exit": "research/evidence explicitly distinguished from implementation"
    },
    {
      "id": "SW-PH-CIVIC",
      "title": "Apply real-world AI landscape to every knowledge nucleus and examine civic sovereignty",
      "deliverables": [
        "AI-in-use domain mapping",
        "existing products and open-source comparison",
        "operating model independent of own AI",
        "civic governance and cultural knowledge research"
      ],
      "exit": "concrete services verified and conceptual vs actual capabilities distinguished"
    }
  ],
