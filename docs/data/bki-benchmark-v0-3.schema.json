{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bürger-KI benchmark record structural draft",
  "type": "object",
  "required": [
    "schema",
    "records",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "bki-benchmark/0.3"
    },
    "status": {
      "const": "structural_validation_passed_semantic_review_pending"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "benchmark_id",
          "version",
          "name",
          "unit",
          "population",
          "place",
          "observed_period",
          "source",
          "source_date",
          "measurement_method",
          "uncertainty",
          "review_status",
          "comparability_status"
        ],
        "properties": {
          "benchmark_id": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "population": {
            "type": [
              "string",
              "null"
            ]
          },
          "place": {
            "type": "string"
          },
          "observed_period": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "source_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "measurement_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_status": {
            "enum": [
              "not_reviewed",
              "reviewed",
              "rejected"
            ]
          },
          "comparability_status": {
            "enum": [
              "not_authorized",
              "authorized_after_validation"
            ]
          }
        }
      }
    }
  }
}