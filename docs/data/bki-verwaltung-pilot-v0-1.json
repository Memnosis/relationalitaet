    {
      "id": "BK-ADM-02",
      "title": "Meldebescheinigung",
      "source_ids": [
        "SRC-BMG-18",
        "SRC-BUND-MB-BB"
      ],
      "sources": [
        {
          "id": "SRC-BMG-18",
          "url": "https://www.gesetze-im-internet.de/bmg/__18.html",
          "authority": "Bundesrecht § 18 BMG",
          "type": "primary_law"
        },
        {
          "id": "SRC-BUND-MB-BB",
          "url": "https://verwaltung.bund.de/leistungsverzeichnis/DE/leistung/99115009001000/herausgeber/BB-126755977/region/120520000000",
          "authority": "Bundesportal Beispiel Cottbus",
          "type": "regional_service_description"
        }
      ],
      "rules": [
        {
          "id": "MB-R1",
          "match": {
            "request": "ordinary"
          },
          "answer": "Eine Meldebescheinigung ist bei der Meldebehörde zu beantragen (§ 18 BMG).",
          "source_ids": [
            "SRC-BMG-18"
          ]
        },
        {
          "id": "MB-R2",
          "match": {
            "request": "electronic"
          },
          "answer": "Die elektronische Meldebescheinigung nach § 18 BMG wird unentgeltlich erteilt; technische Verfügbarkeit und Zugang müssen örtlich geprüft werden.",
          "source_ids": [
            "SRC-BMG-18"
          ]
        },
        {
          "id": "MB-R3",
          "match": {
            "request": "fee_generalization"
          },
          "answer": "Eine einheitliche Gebühr für alle Regionen lässt sich aus der regionalen Leistungsbeschreibung nicht ableiten; Kosten nach Verfahren und Region prüfen.",
          "source_ids": [
            "SRC-BMG-18",
            "SRC-BUND-MB-BB"
          ]
        }
      ]
    },
    {
      "id": "BK-ADM-03",
      "title": "Gewerbeanmeldung",
      "source_ids": [
        "SRC-GEWO-14",
        "SRC-BUND-GEW"
      ],
      "sources": [
        {
          "id": "SRC-GEWO-14",
          "url": "https://www.gesetze-im-internet.de/gewo/__14.html",
          "authority": "Bundesrecht § 14 GewO",
          "type": "primary_law"
        },
        {
          "id": "SRC-BUND-GEW",
          "url": "https://verwaltung.bund.de/leistungsverzeichnis/de/leistung/99050012104000",
          "authority": "Bundesportal",
          "type": "service_description"
        }
      ],
      "rules": [
        {
          "id": "GEW-R1",
          "match": {
            "request": "start"
          },
          "answer": "Beginn eines stehenden Gewerbes muss der zuständigen Behörde gleichzeitig angezeigt werden (§ 14 GewO).",
          "source_ids": [
            "SRC-GEWO-14",
            "SRC-BUND-GEW"
          ]
        },
        {
          "id": "GEW-R2",
          "match": {
            "request": "change"
          },
          "answer": "Auch bestimmte Änderungen, etwa Verlegung oder Wechsel des Gewerbegegenstands, sind nach § 14 GewO anzuzeigen; konkreten Tatbestand prüfen.",
          "source_ids": [
            "SRC-GEWO-14"
          ]
        },
        {
          "id": "GEW-R3",
          "match": {
            "request": "permit"
          },
          "answer": "§ 14 GewO regelt die Anzeige; ob die konkrete Tätigkeit zusätzlich einer Erlaubnis bedarf, lässt sich daraus allein nicht entscheiden.",
          "source_ids": [
            "SRC-GEWO-14"
          ]
        }
      ]
    }
  ],
