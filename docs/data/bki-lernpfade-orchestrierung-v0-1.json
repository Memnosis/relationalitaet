  "topic_expansion_rules": [
    {
      "kind": "core_topic",
      "requires": [
        "question_from_person",
        "five_perspectives",
        "knowledge_selection",
        "source_paths",
        "cross_links",
        "open_limits",
        "canonical_owner"
      ],
      "action": "new_topic_page"
    },
    {
      "kind": "new_finding",
      "requires": [
        "source_id",
        "evidence_status",
        "impacted_object_ids"
      ],
      "action": "update_canonical_object_then_topic_projection"
    },
    {
      "kind": "method_reused",
      "requires": [
        "method_id",
        "context_difference"
      ],
      "action": "link_common_method_and_fach_example_not_duplicate"
    },
    {
      "kind": "deep_dive",
      "requires": [
        "independent_question",
        "material_specialized_knowledge"
      ],
      "action": "subpage_or_paper_and_topic_link"
    },
    {
      "kind": "unverified",
      "requires": [
        "uncertainty",
        "planned_check"
      ],
      "action": "preserve_in_research_and_show_open_question"
    }
  ]
