  "routing_rules": [
    {
      "change": "new_source",
      "primary": "source",
      "also": [
        "concept",
        "relation"
      ],
      "condition": "new source or version with provenance",
      "paper": "only_if_analytic_synthesis"
    },
    {
      "change": "new_term_or_sense",
      "primary": "concept",
      "also": [
        "learning_node",
        "relation"
      ],
      "condition": "semantic novelty verified; retain distinct meanings",
      "paper": "not_required"
    },
    {
      "change": "new_goal_or_context",
      "primary": "goal",
      "also": [
        "skill",
        "learning_node"
      ],
      "condition": "distinct success criterion or requirement",
      "paper": "not_required"
    },
    {
      "change": "new_instruction_or_case_relation",
      "primary": "relation",
      "also": [
        "source",
        "skill",
        "test"
      ],
      "condition": "same jurisdiction, time and legal conditions checked",
      "paper": "only_if_finding_warrants"
    },
    {
      "change": "new_help_provider",
      "primary": "provider",
      "also": [
        "institution",
        "goal"
      ],
      "condition": "service type, public contact and access scope distinguished",
      "paper": "not_required"
    },
    {
      "change": "new_metric_or_method_break",
      "primary": "metric_definition",
      "also": [
        "finding",
        "test",
        "source"
      ],
      "condition": "definition, numerator, denominator, population and year present",
      "paper": "only_if_longitudinal_analysis"
    },
    {
      "change": "new_validated_capability",
      "primary": "skill",
      "also": [
        "test",
        "learning_node",
        "finding"
      ],
      "condition": "real execution and reviewed results",
      "paper": "only_if_substantial"
    },
    {
      "change": "new_analysis_without_verifiable_data",
      "primary": "finding",
      "also": [
        "test",
        "source"
      ],
      "condition": "explicit unknown/not assessed evidence status",
      "paper": "research_note_only"
    }
  ],
