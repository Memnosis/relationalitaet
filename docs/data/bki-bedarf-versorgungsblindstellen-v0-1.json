      "validation": "methodological_risk_not_measured"
    },
    {
      "id": "BLIND-06",
      "label": "Vereinszweck ist kein Leistungsnachweis",
      "explanation": "Registereintrag beweist keine Beratung, Aktualität oder freie Plätze",
